
class Solution:
  def suggestedProducts(self, products: List[str], searchWord: str) -> List[List[str]]:
        # result we are building is going to be a list of lists
        # Will need to use sort the words
        # if words are elminate, they wont be considered
        # need to use a two pointer method (left and right)
        # go character by character to see if they have a matching prefix, if so, keeo the pointer the same.
        # if the character doesn't match, move the left pointer to the next word.
    result = []

    # Sort alphabetically so matches are naturally ordered and grouped together
    products.sort()

    # Pointers defining our valid candidate window [l, r]
    l = 0
    r = len(products) - 1

    # Check matches character-by-character as searchWord is typed
    for i in range(len(searchWord)):
      character = searchWord[i]

      # Shrink window from left if word is too short or character doesn't match
      while l <= r and (len(products[l]) <= i or products[l][i] != character):
        l += 1

      # Shrink window from right if word is too short or character doesn't match
      while l <= r and (len(products[r]) <= i or products[r][i] != character):
        r -= 1

      # Add a new row to store suggestions for current prefix
      result.append([])

      # Number of valid matching words left in window [l, r]
      remaining = r - l + 1

      # Grab up to top 3 matches starting from left pointer 'l'
      for j in range(min(3, remaining)):
        result[-1].append(products[l + j])

    return result
